# The address Arrman should use when it presents links to your services.
MEDIA_SERVER_HOST=192.168.1.50

# Keep these paths identical inside the Arrman container and on the Docker host.
MEDIA_STACK_DIR=/opt/media-stack
MEDIA_COMPOSE_FILE=docker-compose.yml
MEDIA_STATE_ROOT=/nfs

# Arrman joins this existing network so it can reconcile application APIs by
# Compose service name. Find it with: docker network ls
MEDIA_DOCKER_NETWORK=media_default

# Setup bundles should live on durable storage.
ARRMAN_BACKUP_DIR=/nfs/arrman/backups
ARRMAN_WEB_PORT=9876
ARRMAN_VERSION=latest
